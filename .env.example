# Copy to .env and fill in. .env is ignored by git.
DROIDBEAM_API_KEY=change-me-to-a-random-key-of-16-plus-chars
DROIDBEAM_PORT=8080
# LAN address of the Docker host as seen by the phone
DROIDBEAM_LAN_URL=http://192.168.1.10:8080
DROIDBEAM_WEBHOOK_URL=
DROIDBEAM_WEBHOOK_SECRET=
DROIDBEAM_BATTERY_THRESHOLDS=20,80
TZ=Asia/Jakarta
